# Copy to .env and fill in real values. .env is never committed.

# =========================
# Application
# =========================
APP_NAME=SmartPrice
APP_VERSION=0.1.0
CURRENCY_SYMBOL=£
DEBUG=false
ENVIRONMENT=development

# =========================
# API
# =========================
API_PREFIX=/api/v1

# =========================
# Database - PostgreSQL
# =========================
# Used by docker-compose.yml to create the database container
POSTGRES_USER=smartprice
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartprice
POSTGRES_PORT=5432

# Used by the application and Alembic (asyncpg = async PostgreSQL driver).
# Cloud: paste Neon/Supabase's string as-is - e.g. postgresql://user:pw@host/db?sslmode=require
# The app converts it to postgresql+asyncpg://...?ssl=require itself.
# Neon: use the DIRECT connection string (host without "-pooler").
DATABASE_URL=postgresql+asyncpg://smartprice:change-me@localhost:5432/smartprice
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# =========================
# Redis
# =========================
# Cloud (Upstash): rediss://default:<token>@<name>.upstash.io:6379   (rediss = TLS)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT=0.5
CACHE_RETRY_SECONDS=30

# =========================
# Machine Learning
# =========================
MODEL_DIR=models
MODEL_VERSION=v1

# =========================
# Guardrails
# =========================
MINIMUM_MARGIN_MULTIPLIER=1.05
MAX_VOLATILITY_MULTIPLIER=1.50
